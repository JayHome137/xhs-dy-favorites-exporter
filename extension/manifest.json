{
  "manifest_version": 3,
  "name": "XHS & Douyin Favorites Exporter",
  "version": "0.1.0",
  "description": "Export Xiaohongshu and Douyin web favorites to JSON.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Favorites Exporter",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "host_permissions": [
    "https://www.xiaohongshu.com/*",
    "https://www.douyin.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.xiaohongshu.com/*"
      ],
      "js": [
        "xhs-content-script.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.douyin.com/*"
      ],
      "js": [
        "douyin-content-script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "page-bridge.js"
      ],
      "matches": [
        "https://www.xiaohongshu.com/*"
      ]
    }
  ]
}
